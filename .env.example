# Buyer profile — customizes every generated outreach email, LOI, and deal
# packet. Falls back to a generic placeholder if unset (see src/response_engine.py).
BUYER_NAME=Your Name Here
BUYER_EMAIL=you@example.com
BUYER_CREDIBILITY=A qualified buyer looking to acquire a durable, service-based local business with strong cash flow, fair seller financing, and a smooth transition plan that protects employees, customers, and the seller's legacy.

# Email delivery
REPORT_TO_EMAIL=you@example.com
REPORT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Telegram deal alerts (from @BotFather; chat id from getUpdates). Leave unset
# to run with notifications disabled — missing credentials cause a logged skip.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail IMAP — read BizBuySell alert emails (needs 2FA + an App Password).
# The same App Password can also send via smtp.gmail.com, replacing Brevo.
# Only needed for the automated nightly ingest; the CSV path does not need it.
GMAIL_ADDRESS=you@example.com
GMAIL_APP_PASSWORD=

# Live enrichment runs on-demand via Claude (/deep-research + /conduit) — no
# search-API keys needed.
APIFY_TOKEN=

# Database (Supabase session pooler; radar_app role scoped to the radar schema)
DATABASE_URL=postgresql://radar_app.PROJECT_REF:PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres
DATABASE_SCHEMA=radar

# Runtime
DEFAULT_REGION=Mountain West
DEFAULT_TIMEZONE=America/Denver
MIN_SCORE_TO_REPORT=70
