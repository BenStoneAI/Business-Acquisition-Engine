# Email delivery
REPORT_TO_EMAIL=rainking6693@gmail.com
REPORT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Telegram deal alerts (from @BotFather; chat id from getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail IMAP — read BizBuySell alert emails (needs 2FA + an App Password).
# The same App Password can also send via smtp.gmail.com, replacing Brevo.
GMAIL_ADDRESS=rainking6693@gmail.com
GMAIL_APP_PASSWORD=

# Live enrichment runs on-demand via Claude (/deep-research + /conduit) — no
# search-API keys needed.
APIFY_TOKEN=

# Database (Supabase session pooler; radar_app role scoped to the radar schema)
DATABASE_URL=postgresql://radar_app.PROJECT_REF:PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres
DATABASE_SCHEMA=radar

# Runtime
DEFAULT_REGION=Mountain West
DEFAULT_TIMEZONE=America/Denver
MIN_SCORE_TO_REPORT=70
